/* German permission prompts. Keep in step with Info.plist. */
"NSCameraUsageDescription" = "Für Fortschrittsfotos und, wenn du es einschaltest, zum Zählen deiner Wiederholungen. Fotos bleiben auf diesem Telefon und werden nie hochgeladen; beim Zählen wird das Video auf diesem iPhone ausgewertet und nie aufgenommen oder gesendet.";
"NSBluetoothAlwaysUsageDescription" = "Liftsmith verbindet sich mit deinem Brustgurt oder deiner Uhr, um deine Herzfrequenz beim Training live anzuzeigen.";
"NSLocationWhenInUseUsageDescription" = "Liftsmith nutzt beim Öffnen der App deinen ungefähren Standort, um das Studio zu wählen, in dem du bist. Er verfolgt dich nie im Hintergrund, und dein Standort bleibt auf deinem Telefon.";
"NSHealthShareUsageDescription" = "Liftsmith liest Gewicht, Größe, Geschlecht, Geburtsdatum, Körperfett, Ruheherzfrequenz, Schlaf, Herzfrequenzvariabilität, Schritte, VO2max, Atemfrequenz sowie die Kalorien und das Protein aus deiner Ernährungs-App, um dein Training zu planen, deine Wiegungen und deinen täglichen Kalorienbedarf aktuell zu halten, deine Erholung zu zeigen und dir Tipps zur Ernährung zu geben.";
"NSHealthUpdateUsageDescription" = "Liftsmith speichert deine beendeten Trainings mit Kalorien und Herzfrequenz in Health.";
"NSCalendarsFullAccessUsageDescription" = "Liftsmith trägt deine Trainingstage in deinen Kalender ein und schaut, wenn du es einschaltest, wann du beschäftigt bist, um ein Training vorzuschlagen, das in deinen Tag passt. Es liest nur die Zeiten, nie den Inhalt deiner Termine.";
"NSCalendarsUsageDescription" = "Liftsmith trägt deine Trainingstage in deinen Kalender ein und schaut, wenn du es einschaltest, wann du beschäftigt bist, um ein Training vorzuschlagen, das in deinen Tag passt. Es liest nur die Zeiten, nie den Inhalt deiner Termine.";
"NSMicrophoneUsageDescription" = "Wenn du in Labs das Eintragen per Stimme einschaltest, hört Liftsmith zu, sobald du auf das Mikrofon tippst, damit du einen Satz sagen kannst, etwa „100 für 8“. Die Sprache wird auf diesem iPhone erkannt und nie aufgenommen oder gesendet.";
"NSSpeechRecognitionUsageDescription" = "Liftsmith macht aus dem, was du sagst, einen eingetragenen Satz, auf diesem iPhone. Deine Stimme wird nie aufgenommen oder gesendet.";
