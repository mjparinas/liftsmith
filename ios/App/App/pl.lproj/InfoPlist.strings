/* Polish permission prompts. Keep in step with Info.plist. */
"NSCameraUsageDescription" = "Liftsmith używa aparatu, żeby robić zdjęcia postępów, skanować kod Liftsmith znajomego i, jeśli to włączysz, liczyć twoje powtórzenia. Zdjęcia zostają na tym telefonie i nigdy nie są wysyłane; liczenie powtórzeń analizuje obraz na tym iPhonie i nigdy go nie nagrywa ani nie wysyła.";
"NSBluetoothAlwaysUsageDescription" = "Liftsmith łączy się z twoim pasem lub zegarkiem z pomiarem tętna, żeby pokazywać tętno na żywo w czasie treningu, z maszynami na siłowni przez Bluetooth, żeby uzupełniać twoje cardio, oraz z twoją wagą Bluetooth, żeby uzupełniać ważenie.";
"NSLocationWhenInUseUsageDescription" = "Liftsmith używa twojej przybliżonej lokalizacji przy otwieraniu aplikacji, żeby wybrać siłownię, w której jesteś. Nigdy nie śledzi cię w tle, a twoja lokalizacja zostaje na telefonie.";
"NSHealthShareUsageDescription" = "Liftsmith odczytuje twoją wagę, wzrost, płeć, datę urodzenia, tkankę tłuszczową, tętno spoczynkowe, sen, zmienność rytmu serca, kroki, VO2 max, częstość oddechów oraz kalorie, białko, węglowodany i tłuszcze zapisane przez twoją aplikację do jedzenia, żeby ułożyć twój trening, aktualizować ważenia i dzienne kalorie, pokazywać twoją regenerację i doradzać ci w sprawie jedzenia. Jeśli włączysz Licz treningi z innych aplikacji, odczytuje też treningi zapisane przez inne aplikacje, żeby liczyły się w twojej regeneracji.";
"NSHealthUpdateUsageDescription" = "Liftsmith zapisuje w aplikacji Zdrowie twoje ukończone treningi, kalorie i tętno.";
"NSCalendarsFullAccessUsageDescription" = "Liftsmith dodaje twoje dni treningowe do kalendarza i, jeśli to włączysz, sprawdza, kiedy nie masz czasu, żeby zaproponować trening, który się zmieści. Patrzy tylko na godziny, nigdy na to, czego dotyczą twoje wydarzenia.";
"NSCalendarsUsageDescription" = "Liftsmith dodaje twoje dni treningowe do kalendarza i, jeśli to włączysz, sprawdza, kiedy nie masz czasu, żeby zaproponować trening, który się zmieści. Patrzy tylko na godziny, nigdy na to, czego dotyczą twoje wydarzenia.";
"NSMicrophoneUsageDescription" = "Jeśli włączysz zapisywanie serii głosem w Laboratorium, Liftsmith słucha po stuknięciu mikrofonu, a ty podajesz serię, na przykład „100 na 8”. Mowa jest rozpoznawana na tym iPhonie i nigdy nie jest nagrywana ani wysyłana.";
"NSSpeechRecognitionUsageDescription" = "Liftsmith zamienia to, co mówisz, w zapisaną serię, na tym iPhonie. Twój głos nigdy nie jest nagrywany ani wysyłany.";
