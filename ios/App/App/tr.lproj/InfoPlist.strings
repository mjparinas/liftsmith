/* Turkish permission prompts. Keep in step with Info.plist. */
"NSCameraUsageDescription" = "Liftsmith kamerayı ilerleme fotoğrafları çekmek, bir arkadaşının Liftsmith kodunu taramak ve açarsan tekrarlarını saymak için kullanır. Fotoğraflar bu telefonda kalır, asla yüklenmez; tekrar sayımı videoyu bu iPhone'da analiz eder, asla kaydetmez ya da göndermez.";
"NSBluetoothAlwaysUsageDescription" = "Liftsmith antrenman sırasında canlı nabzını göstermek için nabız bandına ya da saatine, kardiyonu doldurmak için Bluetooth spor salonu makinelerine ve tartını doldurmak için Bluetooth tartına bağlanır.";
"NSLocationWhenInUseUsageDescription" = "Liftsmith, uygulamayı açtığında bulunduğun spor salonunu seçmek için yaklaşık konumunu kullanır. Seni asla arka planda izlemez ve konumun telefonunda kalır.";
"NSHealthShareUsageDescription" = "Liftsmith antrenmanını hazırlamak, tartılarını ve günlük kalorilerini güncel tutmak, ne kadar toparlandığını göstermek ve beslenmen konusunda sana koçluk yapmak için kilonu, boyunu, cinsiyetini, doğum tarihini, vücut yağını, dinlenik nabzını, uykunu, nabız değişkenliğini, adımlarını, VO2 max'ını, solunum hızını ve beslenme uygulamanın kaydettiği kalori, protein, karbonhidrat ve yağı okur. Diğer uygulamalardaki antrenmanları say seçeneğini açarsan, diğer uygulamaların kaydettiği antrenmanları da okuyarak toparlanmanda sayar.";
"NSHealthUpdateUsageDescription" = "Liftsmith biten antrenmanlarını, kalorilerini ve nabzını Apple Sağlık'a kaydeder.";
"NSCalendarsFullAccessUsageDescription" = "Liftsmith antrenman günlerini takvimine ekler ve açarsan, sana uygun bir antrenman önerebilmek için ne zaman meşgul olduğuna bakar. Yalnızca saatlere bakar, etkinliklerinin ne olduğuna asla bakmaz.";
"NSCalendarsUsageDescription" = "Liftsmith antrenman günlerini takvimine ekler ve açarsan, sana uygun bir antrenman önerebilmek için ne zaman meşgul olduğuna bakar. Yalnızca saatlere bakar, etkinliklerinin ne olduğuna asla bakmaz.";
"NSMicrophoneUsageDescription" = "Laboratuvar'da sesle set kaydını açarsan Liftsmith, “100 ile 8” gibi bir seti söyleyebilmen için mikrofona dokunduğunda dinler. Konuşma bu iPhone'da tanınır, asla kaydedilmez ya da gönderilmez.";
"NSSpeechRecognitionUsageDescription" = "Liftsmith söylediklerini bu iPhone'da kaydedilmiş bir sete dönüştürür. Sesin asla kaydedilmez ya da gönderilmez.";
