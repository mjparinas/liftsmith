/* Spanish permission prompts. Keep in step with Info.plist. */
"NSCameraUsageDescription" = "Para tomar fotos de progreso y, si lo activas, contar tus repeticiones. Las fotos se quedan en este teléfono y nunca se suben; el conteo analiza el vídeo en este iPhone y nunca lo graba ni lo envía.";
"NSBluetoothAlwaysUsageDescription" = "Liftsmith se conecta a tu banda o reloj de frecuencia cardiaca para mostrar tu pulso en directo durante los entrenamientos, y a máquinas de gimnasio por Bluetooth para rellenar tu cardio.";
"NSLocationWhenInUseUsageDescription" = "Liftsmith usa tu ubicación aproximada al abrir la app para elegir el gimnasio en el que estás. Nunca te sigue en segundo plano y tu ubicación se queda en tu teléfono.";
"NSHealthShareUsageDescription" = "Liftsmith lee tu peso, altura, sexo, fecha de nacimiento, grasa corporal, frecuencia cardiaca en reposo, sueño, variabilidad de la frecuencia cardiaca, pasos, VO2 máx., frecuencia respiratoria y las calorías y proteínas que registra tu app de comidas para preparar tu entrenamiento, mantener al día tus pesajes y calorías diarias, mostrar cuánto te has recuperado y aconsejarte sobre lo que comes.";
"NSHealthUpdateUsageDescription" = "Liftsmith guarda en Salud tus entrenamientos terminados, las calorías y la frecuencia cardiaca.";
"NSCalendarsFullAccessUsageDescription" = "Liftsmith añade tus días de entrenamiento al calendario y, si lo activas, mira cuándo estás ocupado para ofrecerte un entrenamiento que encaje. Solo mira las horas, nunca de qué tratan tus eventos.";
"NSCalendarsUsageDescription" = "Liftsmith añade tus días de entrenamiento al calendario y, si lo activas, mira cuándo estás ocupado para ofrecerte un entrenamiento que encaje. Solo mira las horas, nunca de qué tratan tus eventos.";
"NSMicrophoneUsageDescription" = "Si activas el registro de series por voz en Labs, Liftsmith escucha cuando tocas el micrófono para que digas una serie, como «100 por 8». La voz se reconoce en este iPhone y nunca se graba ni se envía.";
"NSSpeechRecognitionUsageDescription" = "Liftsmith convierte lo que dices en una serie registrada, en este iPhone. Tu voz nunca se graba ni se envía.";
