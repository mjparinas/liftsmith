/* Brazilian Portuguese permission prompts. Keep in step with Info.plist. */
"NSCameraUsageDescription" = "O Liftsmith usa a câmera para tirar fotos de progresso, escanear o código do Liftsmith de um amigo e, se você ativar, contar suas repetições. As fotos ficam neste celular e nunca são enviadas; a contagem analisa o vídeo neste iPhone e nunca o grava nem envia.";
"NSBluetoothAlwaysUsageDescription" = "O Liftsmith se conecta à sua cinta ou relógio de frequência cardíaca para mostrar seus batimentos ao vivo durante os treinos, a aparelhos de academia Bluetooth para preencher seu cardio e à sua balança Bluetooth para preencher sua pesagem.";
"NSLocationWhenInUseUsageDescription" = "O Liftsmith usa sua localização aproximada quando você abre o app para escolher a academia onde você está. Ele nunca rastreia você em segundo plano, e sua localização fica no seu celular.";
"NSHealthShareUsageDescription" = "O Liftsmith lê seu peso, altura, sexo, data de nascimento, gordura corporal, frequência cardíaca em repouso, sono, variabilidade da frequência cardíaca, passos, VO2 máx., frequência respiratória e as calorias, proteínas, carboidratos e gorduras que seu app de alimentação registra para montar seu treino, manter suas pesagens e calorias diárias em dia, mostrar o quanto você está recuperado e orientar você sobre o que come.";
"NSHealthUpdateUsageDescription" = "O Liftsmith salva no Apple Saúde seus treinos concluídos, as calorias e a frequência cardíaca.";
"NSCalendarsFullAccessUsageDescription" = "O Liftsmith adiciona seus dias de treino ao calendário e, se você ativar, vê quando você está ocupado para sugerir um treino que caiba na sua agenda. Ele só olha os horários, nunca do que tratam seus eventos.";
"NSCalendarsUsageDescription" = "O Liftsmith adiciona seus dias de treino ao calendário e, se você ativar, vê quando você está ocupado para sugerir um treino que caiba na sua agenda. Ele só olha os horários, nunca do que tratam seus eventos.";
"NSMicrophoneUsageDescription" = "Se você ativar o registro de séries por voz no Labs, o Liftsmith escuta quando você toca no microfone para você dizer uma série, como “100 por 8”. A fala é reconhecida neste iPhone e nunca é gravada nem enviada.";
"NSSpeechRecognitionUsageDescription" = "O Liftsmith transforma o que você diz em uma série registrada, neste iPhone. Sua voz nunca é gravada nem enviada.";
