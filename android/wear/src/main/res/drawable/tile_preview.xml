<?xml version="1.0" encoding="utf-8"?>
<!-- What the Today tile looks like in the tile picker: the workout mark on the app's dark card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg" />
            <size android:width="192dp" android:height="192dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_workout" android:gravity="center" android:width="64dp" android:height="64dp" />
</layer-list>
