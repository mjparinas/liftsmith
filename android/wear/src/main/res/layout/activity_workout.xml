<?xml version="1.0" encoding="utf-8"?>
<!-- One column, centred, with room for a round screen's edge. Buttons are at least 52 dp tall (Wear's minimum is 48) and grow with the watch's font size. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="200dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Why the exercise is there after a Machine taken swap (src/lib/takenSwap.ts). -->
        <TextView
            android:id="@+id/why"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Adjust the set (watch-apps.md "Adjust and rate a set"): − / + and the crown or bezel move the weight along
             the phone's ladder and the reps; tap a number to pick which one the crown moves. -->
        <LinearLayout
            android:id="@+id/adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:id="@+id/weightRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/weightDown"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/button"
                android:contentDescription="@string/lighter"
                android:text="@string/minus"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="48dp"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/weightUp"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/button"
                android:contentDescription="@string/heavier"
                android:text="@string/plus"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/repsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/repsDown"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/button"
                android:contentDescription="@string/fewer_reps"
                android:text="@string/minus"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="48dp"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/repsUp"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/button"
                android:contentDescription="@string/more_reps"
                android:text="@string/plus"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/heart"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Start timer on a timed hold, carry or cardio set: counted here, and on the phone from the same moment.
             Its words ("Start timer · 0:40") come from the phone, already in the app's language. -->
        <Button
            android:id="@+id/timerStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_primary"
            android:text="@string/log_set"
            android:textAllCaps="false"
            android:textColor="@color/accent_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/button"
            android:text="@string/add_30"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <!-- Machine taken: the phone swaps to the best pick at this gym, named under the button. -->
        <Button
            android:id="@+id/taken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/button"
            android:text="@string/machine_taken"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/taken_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:visibility="gone" />
        <!-- After an exercise's last set: how did it feel, with the phone's three answers. -->
        <LinearLayout
            android:id="@+id/askBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/askQ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/ask0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/button"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/ask1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/button"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/ask2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/button"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Phone-free workouts (WatchRun): Finish saves the watch's own run for the phone. -->
        <Button
            android:id="@+id/finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/button"
            android:text="@string/finish"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Start on phone, or Install on phone when the phone hasn't got Liftsmith (PhoneLink). -->
        <Button
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_primary"
            android:textAllCaps="false"
            android:textColor="@color/accent_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Start on watch: today's plan, carried from the phone, run here with the phone away. -->
        <Button
            android:id="@+id/watchStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/button"
            android:text="@string/start_on_watch"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
