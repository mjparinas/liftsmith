<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (WorkoutWidget.java). Dark card, accent primary button, as in the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <Button
        android:id="@+id/widget_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_primary"
        android:minHeight="48dp"
        android:text="@string/shortcut_start_short"
        android:textAllCaps="false"
        android:textColor="#FF0A0D12"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_log"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button"
        android:minHeight="48dp"
        android:text="@string/shortcut_log_short"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
