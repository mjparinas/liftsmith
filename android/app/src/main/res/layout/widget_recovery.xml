<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery widget (RecoveryWidget.java): body areas ready to train, the ones still recovering with when they'll be
     ready, and Start. Tapping the text opens Body's muscle view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/rec_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rec_ready_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_recovery_title"
            android:textColor="#FF34D399"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_ready"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_resting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFB27A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_resting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="6"
            android:textColor="#FFB4BECC"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/rec_start"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button_primary"
        android:minHeight="48dp"
        android:text="@string/shortcut_start_short"
        android:textAllCaps="false"
        android:textColor="#FF0A0D12"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
