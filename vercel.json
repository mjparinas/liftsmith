{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "reminders": { "path": "/api/cron/reminders/", "schedule": "5 0 * * *", "requestMethod": "GET" },
    "admin": { "path": "/api/cron/admin/", "schedule": "0 13 * * *", "requestMethod": "GET" },
    "digest-pdt": { "path": "/api/cron/digest/", "schedule": "0 15 * * *", "requestMethod": "GET" },
    "digest-pst": { "path": "/api/cron/digest/", "schedule": "0 16 * * *", "requestMethod": "GET" },
    "gym-imports": { "path": "/api/cron/gym-imports/", "schedule": "*/5 * * * *", "requestMethod": "GET" },
    "gym-refresh": { "path": "/api/cron/gym-refresh/", "schedule": "0 10 * * *", "requestMethod": "GET" },
    "crew": { "path": "/api/cron/crew/", "schedule": "*/15 * * * *", "requestMethod": "GET" },
