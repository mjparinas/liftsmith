{
  "name": "liftsmith",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/mediapipe.mjs && node scripts/leaflet.mjs && node scripts/piper.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/mediapipe.mjs && node scripts/leaflet.mjs && node scripts/piper.mjs && npm run locales",
    "build": "next build",
    "postbuild": "node scripts/csp.mjs && node scripts/bundle-check.mjs .next/server",
    "prebuild:static": "node scripts/mediapipe.mjs && node scripts/leaflet.mjs && node scripts/piper.mjs && npm run locales",
    "build:static": "STATIC_EXPORT=1 next build",
    "locales": "node --experimental-strip-types --no-warnings scripts/locales.mjs",
    "capacitor:copy:after": "node scripts/native-web.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:all": "node scripts/e2e.mjs && node scripts/e2e-offline.mjs && node scripts/e2e-devices.mjs && DEVICE='iPhone 16' node scripts/e2e.mjs && node scripts/e2e-a11y.mjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:engine": "tsc --noEmit -p tsconfig.engine.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@capacitor-community/bluetooth-le": "^8.4.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/text-zoom": "^8.0.1",
    "@capgo/capacitor-health": "^8.13.0",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@libsql/client": "^0.18.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@revenuecat/purchases-capacitor": "^14.1.2",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.9.0",
    "canvas-confetti": "^1.9.4",
    "jsqr": "1.4.0",
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "onnxruntime-web": "^1.18.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.2",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.3",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "3.10.1",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
